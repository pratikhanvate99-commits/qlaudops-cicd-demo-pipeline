{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "▶ Run QlaudOps Dashboard",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "env": {
        "PORT": "7000",
        "HOST": "127.0.0.1"
      },
      "console": "integratedTerminal",
      "justMyCode": true,
      "serverReadyAction": {
        "pattern": "running at (http://127\\.0\\.0\\.1:[0-9]+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ]
}
